# ---- database ----
DATABASE_URL=postgres://localhost:5432/pactwright

# ---- network (required; startup fails if incomplete) ----
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=
STELLAR_RPC_URL=
HISTORY_SOURCE_URL=              # backfill when the cursor falls outside RPC retention (B10)
PACT_CONTRACT_ID=
RECEIPT_ANCHOR_ID=
FACILITATOR_URL=

# ---- anchorer ----
ANCHORER_SECRET_REF=             # KMS reference; ReceiptAnchor admin key
ANCHOR_SHARD_ID=1

# ---- cron ----
CRON_SECRET=                     # protects /api/sync and /api/anchor
