# ---- database ----
DATABASE_URL=postgres://localhost:5432/pactwright

# ---- network (required; startup fails if incomplete) ----
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=
STELLAR_RPC_URL=
HISTORY_RPC_URL=                 # archival Stellar RPC used to backfill when the cursor falls outside RPC retention (B10)
HISTORY_SOURCE_URL=              # or an HTTP history service returning base64-XDR events + scannedThroughLedger
PACT_CONTRACT_ID=
RECEIPT_ANCHOR_ID=
REFUND_VAULT_IDS=                # comma-separated RefundVaults whose refunds are indexed
INDEX_START_LEDGER=              # first ledger to index when a source has no cursor yet
FACILITATOR_URL=
VERIFIER_URL=                    # testnet verifier service; /api/ops/health reads its verdict counters (XC-03)

# ---- anchorer (ReceiptAnchor admin key & batching) ----
ANCHORER_SECRET=                 # testnet only; refused on pubnet
ANCHORER_SECRET_REF=             # KMS reference for pubnet (not supported yet)
SPONSOR_ACCOUNT=                 # address to watch for the low-balance alert when the signing key is not in the environment
ANCHOR_MAX_BATCH_SIZE=100        # maximum receipts to anchor per batch (cap: 1000)
ANCHOR_MIN_INTERVAL_SECONDS=0    # minimum elapsed seconds since last batch before planning a new batch

# ---- cron ----
CRON_SECRET=                     # protects /api/sync and /api/anchor

# ---- ops monitoring, probe thresholds & alerts ----
OPS_ALERT_WEBHOOK=               # destination webhook URL for CRITICAL alert delivery (Slack/Discord/generic JSON)
PROBE_MIN_SPONSOR_BALANCE_XLM=10 # minimum XLM balance for sponsor account before CRITICAL alert
PROBE_MAX_INDEXER_LAG_SECONDS=300 # maximum wall-clock lag in seconds before WARNING alert (default: 300s)
PROBE_MAX_INDEXER_LAG_LEDGERS=   # optional override for max ledger lag (defaults to 50% RPC retention)
PROBE_MAX_PENDING_CERTIFICATES=500 # max pending unanchored certificates before backlog warning
PROBE_MAX_VERIFIER_ERROR_RATE=0.05 # max verifier error rate fraction before WARNING alert (default: 0.05)
