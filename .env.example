# ---- database ----
DATABASE_URL=postgres://localhost:5432/pactwright

# ---- network (required; startup fails if incomplete) ----
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=
STELLAR_RPC_URL=
HISTORY_RPC_URL=                 # archival Stellar RPC used to backfill when the cursor falls outside RPC retention (B10)
HISTORY_SOURCE_URL=              # or an HTTP history service returning base64-XDR events + scannedThroughLedger
PACT_CONTRACT_ID=
RECEIPT_ANCHOR_ID=
REFUND_VAULT_IDS=                # comma-separated RefundVaults whose refunds are indexed
INDEX_START_LEDGER=              # first ledger to index when a source has no cursor yet
FACILITATOR_URL=
VERIFIER_URL=                  # testnet verifier service; /api/ops/health reads its verdict counters (XC-03)

# ---- anchorer (ReceiptAnchor admin key) ----
ANCHORER_SECRET=                 # testnet only; refused on pubnet
ANCHORER_SECRET_REF=             # KMS reference for pubnet (not supported yet)
SPONSOR_ACCOUNT=                 # address to watch for the low-balance alert when the signing key is not in the environment

# ---- cron ----
CRON_SECRET=                     # protects /api/sync and /api/anchor
